{
  "info": {
    "name": "nodejs-app",
    "description": "Requests for the nodejs-app API. Set `baseUrl`, `username` and `password` as collection variables (use the values from your local .env). `POST /auth/login` stores the returned JWT in `token`, which the protected requests use automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Liveness probe.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "GET /greetings",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/greetings",
          "host": ["{{baseUrl}}"],
          "path": ["greetings"]
        },
        "description": "Public endpoint.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "POST /auth/login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Exchanges the demo credentials for a short-lived JWT.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeded', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "if (body.token) { pm.collectionVariables.set('token', body.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        },
        "description": "Lists users. Requires a bearer token.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /users/:id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/25",
          "host": ["{{baseUrl}}"],
          "path": ["users", "25"]
        },
        "description": "Returns one user. Requires a bearer token.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "username",
      "value": "demo"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}
