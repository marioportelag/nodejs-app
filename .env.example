# Copy to .env and replace every placeholder. Never commit .env.

# development | test | production (defaults to development; the Docker image sets production).
# NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Number of trusted reverse-proxy hops (0 when not behind a proxy).
TRUST_PROXY=0

# Required. At least 32 characters, e.g. generated with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=nodejs-app
JWT_AUDIENCE=nodejs-app-api

# Required. Demo-only single account (see README "Known limitations").
DEMO_USERNAME=demo
DEMO_PASSWORD=replace-with-a-strong-demo-password

LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
